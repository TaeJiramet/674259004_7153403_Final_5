PORT=10000
NODE_ENV=development

# ตัวเลือก 1: สำหรับ Render PostgreSQL (Connection String)
# DATABASE_URL=postgres://username:password@render-host:5432/databasename

# ตัวเลือก 2: สำหรับ Local Database (PostgreSQL / MySQL)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_resources_db
DB_USER=postgres
DB_PASSWORD=postgres
